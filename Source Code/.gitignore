# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Java
/backend/target/

# Go
/backend/go-backend

# Rust
/backend/rust/target/

# frontend generated files
/frontend/node_modules/
/frontend/.next/

# playwright output (regenerated every test run)
/test-results/

# yarn berry install state (regenerated on install)
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# rust service product data (bootstrapped by `yarn dev`)
/backend/rust/products.json

{
  "name": "elite-shop",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "build": "cd frontend && npx next build",
    "start": "cd frontend && npx next start",
    "lint": "cd frontend && npx eslint",
    "install:all": "node scripts/install-all.mjs",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "backend": "node scripts/dev-all.mjs --backend-only",
    "backend:java": "cd backend && java -jar target/elite-shop-backend-*.jar",
    "backend:rust": "cd backend/rust && ./target/release/products-service products.json",
    "backend:go": "backend/go-backend",
    "backend:calc": "cd backend/cpp-backend && cmake -B build && cmake --build build -j && ./build/calc_server"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "packageManager": "yarn@4.18.1"
}

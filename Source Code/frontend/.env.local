# ── Email Configuration for Admin Password ──
# WORKS OUT OF THE BOX with direct delivery (no config needed).
# If direct delivery fails, uncomment and set SMTP_USER/SMTP_PASS below.
# SMTP_USER=your@email.com
# SMTP_PASS=your-password-or-app-password

# ── CMS (Contentful) ──
# Leave blank to use fallback product data from Rust backend
# CONTENTFUL_SPACE_ID=your_space_id
# CONTENTFUL_ACCESS_TOKEN=your_access_token
# CONTENTFUL_PREVIEW=false

# ── Payments (Stripe) ──
# Leave blank for demo mode (no real payments processed)
# STRIPE_SECRET_KEY=sk_test_your_key
# STRIPE_WEBHOOK_SECRET=whsec_your_secret

# ── Revalidation ──
# Secret token for on-demand ISR revalidation (CMS webhooks)
REVALIDATION_SECRET=elite-revalidation-secret

# ── Site URL ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

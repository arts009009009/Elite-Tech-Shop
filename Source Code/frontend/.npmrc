node-linker=hoisted
onlyBuiltDependencies[]=unrs-resolver
# next is pinned to a canary (16.4.0-canary.10); strict semver treats that
# prerelease as NOT satisfying @oprogress/next's peer range "next>=13.0.0",
# so a plain `npm install` dies with ERESOLVE. The pair works together fine
# (verified by the build + full E2E suite), so skip strict peer solving.
legacy-peer-deps=true
